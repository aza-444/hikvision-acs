/* ============================================================
   Hikvision Access Control System - Dark Theme
   Zamonaviy, professional ko'rinish
   ============================================================ */

/* Umumiy */
QMainWindow, QDialog {
    background-color: #1a1d23;
    color: #e0e0e0;
    font-family: "Segoe UI", "SF Pro Display", sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: transparent;
    color: #e0e0e0;
}

/* Sarlavha va menyular */
QMenuBar {
    background-color: #12141a;
    color: #e0e0e0;
    border-bottom: 1px solid #2a2d35;
    padding: 2px;
}

QMenuBar::item:selected {
    background-color: #2563eb;
    border-radius: 4px;
}

QMenu {
    background-color: #1e2028;
    border: 1px solid #2a2d35;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2563eb;
}

/* Statusbar */
QStatusBar {
    background-color: #12141a;
    color: #9ca3af;
    border-top: 1px solid #2a2d35;
    font-size: 12px;
}

/* Toolbar */
QToolBar {
    background-color: #12141a;
    border: none;
    padding: 4px 8px;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background: #2a2d35;
    margin: 4px 8px;
}

/* Tugmalar */
QPushButton {
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-weight: 600;
    font-size: 13px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #3b82f6;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

QPushButton:disabled {
    background-color: #374151;
    color: #6b7280;
}

QPushButton#btnDanger {
    background-color: #dc2626;
}

QPushButton#btnDanger:hover {
    background-color: #ef4444;
}

QPushButton#btnSuccess {
    background-color: #16a34a;
}

QPushButton#btnSuccess:hover {
    background-color: #22c55e;
}

QPushButton#btnWarning {
    background-color: #d97706;
}

QPushButton#btnSecondary {
    background-color: #374151;
    color: #d1d5db;
}

QPushButton#btnSecondary:hover {
    background-color: #4b5563;
}

QPushButton#btnOutline {
    background-color: transparent;
    border: 1px solid #374151;
    color: #d1d5db;
}

QPushButton#btnOutline:hover {
    background-color: #1f2937;
    border-color: #4b5563;
}

/* Sidebar tugmalari */
QPushButton#sidebarBtn {
    background-color: transparent;
    color: #9ca3af;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#sidebarBtn:hover {
    background-color: #1f2937;
    color: #e5e7eb;
}

QPushButton#sidebarBtn:checked, QPushButton#sidebarBtnActive {
    background-color: #2563eb;
    color: white;
}

/* Inputlar */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1f2937;
    color: #e0e0e0;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #2563eb;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2563eb;
    background-color: #111827;
}

QLineEdit:disabled {
    background-color: #111827;
    color: #6b7280;
}

/* Combobox */
QComboBox {
    background-color: #1f2937;
    color: #e0e0e0;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #4b5563;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: #1e2028;
    border: 1px solid #374151;
    border-radius: 8px;
    color: #e0e0e0;
    selection-background-color: #2563eb;
    padding: 4px;
}

/* Jadval (Table) */
QTableWidget, QTableView {
    background-color: #111827;
    alternate-background-color: #1a1f2e;
    color: #e0e0e0;
    border: 1px solid #1f2937;
    border-radius: 8px;
    gridline-color: #1f2937;
    selection-background-color: rgba(37, 99, 235, 0.3);
    selection-color: #e0e0e0;
    font-size: 13px;
}

QTableWidget::item, QTableView::item {
    padding: 6px 10px;
    border-bottom: 1px solid #1f2937;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: rgba(37, 99, 235, 0.3);
}

QHeaderView::section {
    background-color: #12141a;
    color: #9ca3af;
    border: none;
    border-bottom: 2px solid #2563eb;
    padding: 10px 12px;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
}

QHeaderView::section:hover {
    background-color: #1f2937;
    color: #e5e7eb;
}

/* ScrollBar */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #374151;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4b5563;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #374151;
    border-radius: 4px;
    min-width: 30px;
}

/* TabWidget */
QTabWidget::pane {
    background-color: #1a1d23;
    border: 1px solid #1f2937;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #9ca3af;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 500;
    font-size: 13px;
}

QTabBar::tab:hover {
    color: #e5e7eb;
    background-color: #1f2937;
}

QTabBar::tab:selected {
    color: #2563eb;
    border-bottom-color: #2563eb;
}

/* GroupBox */
QGroupBox {
    background-color: #1f2937;
    border: 1px solid #374151;
    border-radius: 12px;
    margin-top: 16px;
    padding: 20px 16px 16px;
    font-weight: 600;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    padding: 0 8px;
    color: #9ca3af;
}

/* Label */
QLabel {
    color: #e0e0e0;
}

QLabel#title {
    font-size: 24px;
    font-weight: 700;
    color: #f9fafb;
}

QLabel#subtitle {
    font-size: 14px;
    color: #9ca3af;
}

QLabel#statValue {
    font-size: 36px;
    font-weight: 700;
    color: #f9fafb;
}

QLabel#statLabel {
    font-size: 12px;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* DateEdit */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #1f2937;
    color: #e0e0e0;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border-color: #2563eb;
}

QCalendarWidget {
    background-color: #1e2028;
    color: #e0e0e0;
}

/* CheckBox, RadioButton */
QCheckBox, QRadioButton {
    color: #e0e0e0;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

/* ProgressBar */
QProgressBar {
    background-color: #1f2937;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 4px;
}

/* Frame */
QFrame#cardFrame {
    background-color: #1f2937;
    border: 1px solid #374151;
    border-radius: 12px;
    padding: 16px;
}

QFrame#cardFrameBlue {
    background-color: rgba(37, 99, 235, 0.1);
    border: 1px solid rgba(37, 99, 235, 0.3);
    border-radius: 12px;
    padding: 16px;
}

QFrame#cardFrameGreen {
    background-color: rgba(22, 163, 74, 0.1);
    border: 1px solid rgba(22, 163, 74, 0.3);
    border-radius: 12px;
    padding: 16px;
}

QFrame#cardFrameRed {
    background-color: rgba(220, 38, 38, 0.1);
    border: 1px solid rgba(220, 38, 38, 0.3);
    border-radius: 12px;
    padding: 16px;
}

QFrame#cardFrameYellow {
    background-color: rgba(217, 119, 6, 0.1);
    border: 1px solid rgba(217, 119, 6, 0.3);
    border-radius: 12px;
    padding: 16px;
}

QFrame#sidebar {
    background-color: #12141a;
    border-right: 1px solid #1f2937;
}

QFrame#separator {
    background-color: #2a2d35;
    max-height: 1px;
}

/* Splitter */
QSplitter::handle {
    background-color: #1f2937;
    width: 2px;
}

/* ListWidget */
QListWidget {
    background-color: #111827;
    border: 1px solid #1f2937;
    border-radius: 8px;
    color: #e0e0e0;
    outline: none;
}

QListWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #1f2937;
}

QListWidget::item:selected {
    background-color: rgba(37, 99, 235, 0.3);
}

QListWidget::item:hover {
    background-color: #1f2937;
}

/* ToolTip */
QToolTip {
    background-color: #1e2028;
    color: #e0e0e0;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* Dialog buttons */
QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* MessageBox */
QMessageBox {
    background-color: #1a1d23;
}

QMessageBox QLabel {
    color: #e0e0e0;
    font-size: 14px;
}
